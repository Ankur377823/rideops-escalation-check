# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000
# Optional: allow Vercel preview URLs, e.g. https://your-project-.*\.vercel\.app
ALLOWED_ORIGIN_REGEX=
# Optional: enables the AI-written handoff note. Without it the template note is used.
GEMINI_API_KEY=
# Optional: any LiteLLM model name. Check Google AI Studio for a current Flash model.
LLM_MODEL=gemini/gemini-3.5-flash-lite
